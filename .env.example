# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/gail_smartlearn
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d

# File Upload Configuration
MAX_FILE_SIZE=500000000
UPLOAD_PATH=./uploads

# AI Processing Configuration
PYTHON_AI_SERVICE_URL=http://localhost:8000
OPENAI_API_KEY=your_openai_api_key_here
WHISPER_MODEL=base

# Video Processing Configuration
FFMPEG_PATH=/usr/bin/ffmpeg
VIDEO_QUALITY=720p
THUMBNAIL_COUNT=3

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Elasticsearch Configuration
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=gail_smartlearn

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Frontend Configuration
CLIENT_URL=http://localhost:3000

# AWS Configuration (Optional for cloud storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=gail-smartlearn-storage

# Azure Media Services (Optional for advanced video processing)
AZURE_MEDIA_SERVICES_ACCOUNT_NAME=your_azure_account
AZURE_MEDIA_SERVICES_ACCOUNT_KEY=your_azure_key

# Notification Configuration
ENABLE_NOTIFICATIONS=true
SLACK_WEBHOOK_URL=your_slack_webhook_url